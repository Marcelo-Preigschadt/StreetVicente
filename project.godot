; Street Vicente Fighter — Godot 4.5.1, GDScript, Compatibility/WebGL 2.
config_version=5

[application]
config/name="Street Vicente Fighter"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/description="Base de combate 2D: 120 Hz, frame data a 60 fps, Web single-thread."
config/icon="res://assets/icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.035, 0.051, 0.133, 1)

[autoload]
AppSettings="*res://autoloads/app_settings.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=16

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.024, 0.035, 0.063, 1)

[audio]
general/default_playback_type.web=1
